{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VSTauri",
  "version": "1.138.0",
  "identifier": "com.zetsu4i.vstauri",
  "mainBinaryName": "VSTauri",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/code.ico"],
    "publisher": "Mouri Younes",
    "resources": ["resources/client/**/*", "resources/node/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
