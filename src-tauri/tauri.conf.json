{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code - Tauri",
  "version": "0.1.0",
  "identifier": "dev.zetsu4i.codetauri",
  "build": {
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Code - Tauri",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
