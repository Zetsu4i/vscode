{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code - Tauri",
  "version": "0.1.0",
  "identifier": "dev.zetsu4i.codetauri",
  "build": {
    "frontendDist": "../out/vscode-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Code - Tauri",
        "url": "out/vs/code/browser/workbench/workbench.html",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
