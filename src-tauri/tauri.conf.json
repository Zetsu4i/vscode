{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VSTauri",
  "version": "0.1.0",
  "identifier": "com.zetsu4i.vstauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "VSTauri",
        "width": 1400,
        "height": 900,
        "minWidth": 860,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "VSCode-style editor rebuilt on Tauri",
    "longDescription": "A from-scratch rebuild of the VSCode workbench: Rust backend, web frontend, native filesystem, PTY terminal, ripgrep search, git integration and a WASM extension host. Lighter and faster than Electron.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
