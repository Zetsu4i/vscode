{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VSTauri",
  "version": "0.2.0",
  "identifier": "com.zetsu4i.vstauri",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Visual Studio Code on a Rust backbone",
    "longDescription": "The real Visual Studio Code web workbench served by a native Rust backbone (file system, PTY terminal, watcher) inside a Tauri 2 shell. No Electron.",
    "resources": {
      "resources/client/": "client/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
